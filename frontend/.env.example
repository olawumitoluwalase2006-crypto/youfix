# ==============================================================================
# YouFix Frontend Environment Variables (Next.js)
# ==============================================================================

# Backend REST API URL (When deploying to Vercel, replace with your Render/Railway backend URL)
# Example production: NEXT_PUBLIC_API_URL=https://youfix-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Direct Supabase Client (For direct client reads or authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
