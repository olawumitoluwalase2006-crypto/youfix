# ==============================================================================
# YouFix Backend Environment Variables (FastAPI)
# ==============================================================================

# Server Configuration
PORT=8000
ENVIRONMENT=development

# Google Gemini Vision API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL & Storage (Get from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here
SUPABASE_BUCKET=diagnosis-images

# CORS Allowed Origins (Comma-separated or * for development)
# When deploying Next.js to Vercel, add your Vercel URL here (e.g. https://youfix.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Mock Fallback (Allows the application to run smoothly before keys are configured)
ENABLE_MOCK_FALLBACK=true
